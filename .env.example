# ==============================================================================
# Chiranjeev Rastogi - Developer Portfolio Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to configure your local or deployment environment.
# Note: Local .env and .env.* files are strictly excluded from version control.
# ==============================================================================

# Public canonical base URL for the deployed website.
# Used for canonical metadata, OpenGraph URLs, JSON-LD schema, and XML sitemaps.
#
# Classification: Public (Client & Server)
# Required: No (Optional)
# Behavior when unset: Canonical and OpenGraph URLs are safely omitted, and sitemap.xml
#                      returns an empty set to avoid publishing unconfirmed fallback domains.
# Format: Fully qualified URL without trailing slash (e.g., https://chiranjeevrastogi.com)
NEXT_PUBLIC_SITE_URL=
